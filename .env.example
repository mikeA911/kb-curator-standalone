NEXT_PUBLIC_SUPABASE_URL=https://wpdfzyzlwwsmwzxbfmni.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin, no trailing slash -- used for the Blog's
# sitemap, robots.txt, canonical URLs, and social/JSON-LD metadata. Falls
# back to http://localhost:3000 when unset (see src/lib/env.ts).
NEXT_PUBLIC_SITE_URL=https://kbsandbox.tech

# Only the key for a provider actually enabled in ai_providers (admin AI
# Config page) is required at runtime -- see src/lib/ai/registry.ts's
# resolveApiKey(), which looks up whatever env var name is stored on that
# provider's row. All five are listed here so switching the default
# provider doesn't need a redeploy.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=

GATEWAY_API_KEY=
DELEGATION_HS256_SECRET=